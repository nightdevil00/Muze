#!/usr/bin/env bash
# Muze live session launcher (tty1 autologin for the `live` user).
# If Hyprland cannot start (e.g. no GPU / headless VM), drop to a shell so the
# installer and rescue tools remain reachable.
set -u

if [[ "$(tty 2>/dev/null)" != "/dev/tty1" ]]; then
    exec /bin/bash
fi

export XDG_CONFIG_HOME="$HOME/.config"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export PATH="$HOME/.local/bin:$PATH"
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

# Unblock wireless devices in the live environment.
if command -v rfkill >/dev/null 2>&1; then
    sudo rfkill unblock wifi 2>/dev/null || rfkill unblock wifi 2>/dev/null || true
    sudo rfkill unblock bluetooth 2>/dev/null || rfkill unblock bluetooth 2>/dev/null || true
    sudo rfkill unblock all 2>/dev/null || rfkill unblock all 2>/dev/null || true
fi

# Ensure core connectivity services are running (live ISO).
if command -v systemctl >/dev/null 2>&1; then
    sudo systemctl start NetworkManager.service 2>/dev/null || systemctl start NetworkManager.service 2>/dev/null || true
    sudo systemctl start bluetooth.service 2>/dev/null || systemctl start bluetooth.service 2>/dev/null || true
fi

while true; do
    if command -v start-hyprland >/dev/null 2>&1; then
        printf '\n\033[38;5;212mWelcome to Muze\033[0m -- starting the desktop...\n'
        start-hyprland
        status=$?
        printf '\n\033[1;33mHyprland exited (status %s).\033[0m\n' "$status"
    else
        printf '\033[1;33mHyprland/start-hyprland not found.\033[0m\n'
    fi

    printf 'Press Enter to restart the desktop, or type \033[1mshell\033[0m for a shell.\n> '
    read -r choice || choice=""
    if [[ "${choice,,}" == "shell" || "${choice,,}" == "s" ]]; then
        printf '\033[1;33mMuze desktop unavailable.\033[0m Dropping to a shell.\n'
        printf 'Run \033[1msudo muze-install\033[0m to install, or \033[1msudo muze-repair\033[0m to fix a system.\n\n'
        /bin/bash
    fi
done
