#!/usr/bin/env bash
# muze-hypr-apply -- render ~/.config/muze/settings.json into Hyprland config.
#
# Hyprland 0.57+ uses a Lua config. The Settings UI writes settings.json; this
# script turns the "hyprland" object into ~/.config/hypr/muze/look.lua and
# reloads Hyprland. Keeping the generated file separate means a user can
# hand-edit hyprland.lua or override anything in muze/user.lua without the
# settings page clobbering it.
set -euo pipefail

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
SETTINGS="$CONF_DIR/muze/settings.json"
OUT="$CONF_DIR/hypr/muze/look.lua"
DRY=0
[[ "${1:-}" == "--dry-run" ]] && DRY=1

get() { # get <jq-path> <default>
    local v=""
    if [[ -f "$SETTINGS" ]] && command -v jq >/dev/null 2>&1; then
        v=$(jq -r "$1 // empty" "$SETTINGS" 2>/dev/null || true)
    fi
    printf '%s' "${v:-$2}"
}

gaps_in=$(get '.hyprland.gapsIn' 5)
gaps_out=$(get '.hyprland.gapsOut' 10)
border_size=$(get '.hyprland.borderSize' 2)
rounding=$(get '.hyprland.rounding' 12)
active_opacity=$(get '.hyprland.activeOpacity' 1)
inactive_opacity=$(get '.hyprland.inactiveOpacity' 0.95)
blur_enabled=$(get '.hyprland.blurEnabled' true)
blur_size=$(get '.hyprland.blurSize' 6)
animations=$(get '.hyprland.animationsEnabled' true)
layout=$(get '.hyprland.layout' dwindle)
natural_scroll=$(get '.hyprland.naturalScroll' true)
kb_layout=$(get '.hyprland.kbLayout' us)
follow_mouse=$(get '.hyprland.followMouse' 1)
sensitivity=$(get '.hyprland.sensitivity' 0)

# Cheap sanity checks: never write a broken config.
[[ "$gaps_in" =~ ^[0-9]+$ ]] || gaps_in=5
[[ "$gaps_out" =~ ^[0-9]+$ ]] || gaps_out=10
[[ "$border_size" =~ ^[0-9]+$ ]] || border_size=2
[[ "$rounding" =~ ^[0-9]+$ ]] || rounding=12
[[ "$blur_size" =~ ^[0-9]+$ ]] || blur_size=6
[[ "$active_opacity" =~ ^[0-9.]+$ ]] || active_opacity=1
[[ "$inactive_opacity" =~ ^[0-9.]+$ ]] || inactive_opacity=0.95
[[ "$kb_layout" =~ ^[a-zA-Z0-9_,.-]+$ ]] || kb_layout=us
[[ "$follow_mouse" =~ ^[0-9]+$ ]] || follow_mouse=1
[[ "$sensitivity" =~ ^-?[0-9.]+$ ]] || sensitivity=0
case "$layout" in dwindle|master|scrolling) ;; *) layout=dwindle ;; esac
case "$blur_enabled" in true|false) ;; *) blur_enabled=true ;; esac
case "$animations" in true|false) ;; *) animations=true ;; esac
case "$natural_scroll" in true|false) ;; *) natural_scroll=true ;; esac

CONF=$(cat <<EOF
-- Generated by muze-hypr-apply from ~/.config/muze/settings.json. Do not edit.
-- Override anything here in ~/.config/hypr/muze/user.lua (loaded last).
hl.config({
    general = {
        gaps_in = $gaps_in,
        gaps_out = $gaps_out,
        border_size = $border_size,
        layout = "$layout",
    },

    decoration = {
        rounding = $rounding,
        active_opacity = $active_opacity,
        inactive_opacity = $inactive_opacity,

        blur = {
            enabled = $blur_enabled,
            size = $blur_size,
            passes = 2,
            vibrancy = 0.17,
        },

        shadow = {
            enabled = true,
            range = 8,
            render_power = 3,
            color = "rgba(000000aa)",
        },
    },

    animations = {
        enabled = $animations,
    },

    input = {
        kb_layout = "$kb_layout",
        follow_mouse = $follow_mouse,
        sensitivity = $sensitivity,
        touchpad = {
            natural_scroll = $natural_scroll,
        },
    },
})
EOF
)

if [[ $DRY -eq 1 ]]; then
    printf '%s\n' "$CONF"
    exit 0
fi

mkdir -p "$(dirname "$OUT")"
printf '%s\n' "$CONF" > "$OUT"

if command -v hyprctl >/dev/null 2>&1 && hyprctl version >/dev/null 2>&1; then
    hyprctl reload >/dev/null 2>&1 || printf 'muze-hypr-apply: hyprctl reload failed\n' >&2
fi
