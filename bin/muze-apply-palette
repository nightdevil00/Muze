#!/usr/bin/env bash
# Apply a Muze palette (JSON) to terminal/toolkit color files so preset themes
# recolor apps the same way wallpaper/matugen theming does.
# Reads palette JSON from stdin or from file argument.
# Expected keys: bgBase,bgSurface,bgHover,bgSelected,bgBorder,textPrimary,
# textSecondary,textMuted,accentPrimary,accentCyan,accentGreen,accentOrange,accentRed
set -euo pipefail

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
mkdir -p "$CONF_DIR/kitty" "$CONF_DIR/foot" "$CONF_DIR/fuzzel" "$CONF_DIR/qt6ct/colors" "$CONF_DIR/btop/themes" "$CONF_DIR/hypr"

src="${1:--}"
tmp=""
if [[ "$src" == "-" || -z "$src" ]]; then
    tmp=$(mktemp)
    cat > "$tmp"
    src="$tmp"
fi
cleanup() { [[ -n "$tmp" ]] && rm -f "$tmp"; }
trap cleanup EXIT

python3 - "$src" <<'PY'
import json, os, sys, glob, subprocess

src = sys.argv[1]
with open(src, 'r', encoding='utf-8') as f:
    data = json.load(f)
if not isinstance(data, dict):
    raise SystemExit('palette must be a JSON object')

def g(k, d='#000000'):
    v = data.get(k, d)
    return str(v).strip() if v is not None else d

def nohash(v):
    return str(v).lstrip('#')

home = os.path.expanduser('~')
conf = os.environ.get('XDG_CONFIG_HOME', os.path.join(home, '.config'))

bgBase=g('bgBase'); bgSurface=g('bgSurface'); bgHover=g('bgHover'); bgSelected=g('bgSelected'); bgBorder=g('bgBorder')
textPrimary=g('textPrimary'); textSecondary=g('textSecondary'); textMuted=g('textMuted')
accentPrimary=g('accentPrimary'); accentCyan=g('accentCyan'); accentGreen=g('accentGreen'); accentOrange=g('accentOrange'); accentRed=g('accentRed')

# Kitty (matugen include path)
kitty = f"""background {bgBase}
foreground {textPrimary}
cursor {accentPrimary}
cursor_text_color {bgBase}
selection_background {bgSelected}
selection_foreground {textPrimary}
color0 {bgSurface}
color1 {accentRed}
color2 {accentGreen}
color3 {accentOrange}
color4 {accentPrimary}
color5 {accentPrimary}
color6 {accentCyan}
color7 {textSecondary}
color8 {textMuted}
color9 {accentRed}
color10 {accentGreen}
color11 {accentOrange}
color12 {accentPrimary}
color13 {accentPrimary}
color14 {accentCyan}
color15 {textPrimary}
active_tab_foreground {textPrimary}
active_tab_background {bgSurface}
inactive_tab_foreground {textMuted}
inactive_tab_background {bgBase}
"""
open(os.path.join(conf,'kitty','muze-colors.conf'),'w',encoding='utf-8').write(kitty)

# Also write theme-colors.conf for compatibility with existing theme switcher behavior
open(os.path.join(conf,'kitty','theme-colors.conf'),'w',encoding='utf-8').write(kitty)

# Foot
foot = f"""# Generated by muze-apply-palette
[colors-dark]
background={nohash(bgBase)}
foreground={nohash(textPrimary)}
regular0={nohash(bgSurface)}
regular1={nohash(accentRed)}
regular2={nohash(accentGreen)}
regular3={nohash(accentOrange)}
regular4={nohash(accentPrimary)}
regular5={nohash(accentPrimary)}
regular6={nohash(accentCyan)}
regular7={nohash(textSecondary)}
bright0={nohash(textMuted)}
bright1={nohash(accentRed)}
bright2={nohash(accentGreen)}
bright3={nohash(accentOrange)}
bright4={nohash(accentPrimary)}
bright5={nohash(accentPrimary)}
bright6={nohash(accentCyan)}
bright7={nohash(textPrimary)}
selection-foreground={nohash(textPrimary)}
selection-background={nohash(bgSelected)}
alpha=0.94
"""
open(os.path.join(conf,'foot','muze-colors.ini'),'w',encoding='utf-8').write(foot)

# Fuzzel
fuzzel = f"""[colors]
background={nohash(bgBase)}f2
text={nohash(textPrimary)}ff
prompt={nohash(accentPrimary)}ff
placeholder={nohash(textMuted)}ff
input={nohash(textPrimary)}ff
match={nohash(accentCyan)}ff
selection={nohash(bgSelected)}ff
selection-text={nohash(textPrimary)}ff
selection-match={nohash(accentPrimary)}ff
counter={nohash(textMuted)}ff
border={nohash(accentPrimary)}ff
"""
open(os.path.join(conf,'fuzzel','muze-colors.ini'),'w',encoding='utf-8').write(fuzzel)

# btop
btop = f'''theme[main_bg]="{bgBase}"
theme[main_fg]="{textPrimary}"
theme[title]="{textPrimary}"
theme[hi_fg]="{accentPrimary}"
theme[selected_bg]="{bgSelected}"
theme[selected_fg]="{textPrimary}"
theme[inactive_fg]="{textMuted}"
theme[graph_text]="{textSecondary}"
theme[meter_bg]="{bgSurface}"
theme[proc_misc]="{accentPrimary}"
theme[cpu_box]="{bgBorder}"
theme[mem_box]="{bgBorder}"
theme[net_box]="{bgBorder}"
theme[proc_box]="{bgBorder}"
theme[div_line]="{bgBorder}"
theme[temp_start]="{accentCyan}"
theme[temp_mid]="{accentOrange}"
theme[temp_end]="{accentRed}"
theme[cpu_start]="{accentGreen}"
theme[cpu_mid]="{accentCyan}"
theme[cpu_end]="{accentPrimary}"
theme[free_start]="{bgSurface}"
theme[free_mid]="{accentCyan}"
theme[free_end]="{textPrimary}"
theme[cached_start]="{accentCyan}"
theme[cached_mid]="{accentPrimary}"
theme[cached_end]="{textPrimary}"
theme[available_start]="{accentOrange}"
theme[available_mid]="{accentCyan}"
theme[available_end]="{accentGreen}"
theme[used_start]="{accentPrimary}"
theme[used_mid]="{accentCyan}"
theme[used_end]="{accentRed}"
theme[download_start]="{accentCyan}"
theme[download_mid]="{accentPrimary}"
theme[download_end]="{textPrimary}"
theme[upload_start]="{accentPrimary}"
theme[upload_mid]="{accentCyan}"
theme[upload_end]="{accentRed}"
theme[process_start]="{accentGreen}"
theme[process_mid]="{accentPrimary}"
theme[process_end]="{accentRed}"
'''
os.makedirs(os.path.join(conf,'btop','themes'), exist_ok=True)
open(os.path.join(conf,'btop','themes','muze.theme'),'w',encoding='utf-8').write(btop)

# qt6ct colors (simple)
qt = f"""[ColorScheme]
active_colors={textPrimary}, {bgSurface}, {bgBorder}, {bgBorder}, {bgSurface}, {bgBorder}, {textPrimary}, {textPrimary}, {textPrimary}, {bgBase}, {bgSurface}, {bgBorder}, {accentPrimary}, {textPrimary}, {accentPrimary}, {accentCyan}, {bgSurface}, {bgBase}, {bgSurface}, {textPrimary}, {textMuted}
inactive_colors={textSecondary}, {bgSurface}, {bgBorder}, {bgBorder}, {bgSurface}, {bgBorder}, {textSecondary}, {textSecondary}, {textSecondary}, {bgBase}, {bgSurface}, {bgBorder}, {bgSelected}, {textSecondary}, {accentPrimary}, {accentCyan}, {bgSurface}, {bgBase}, {bgSurface}, {textSecondary}, {textMuted}
disabled_colors={textMuted}, {bgSurface}, {bgBorder}, {bgBorder}, {bgSurface}, {bgBorder}, {textMuted}, {textMuted}, {textMuted}, {bgBase}, {bgSurface}, {bgBorder}, {bgSelected}, {textMuted}, {accentPrimary}, {accentCyan}, {bgSurface}, {bgBase}, {bgSurface}, {textMuted}, {textMuted}
"""
os.makedirs(os.path.join(conf,'qt6ct','colors'), exist_ok=True)
open(os.path.join(conf,'qt6ct','colors','muze.conf'),'w',encoding='utf-8').write(qt)

# GTK 3/4 (for Nautilus and other GTK apps) - simplified mapping for preset palettes
gtk4 = f""":root {{
  --accent-bg-color: {accentPrimary};
  --accent-fg-color: {bgBase};
  --accent-color: {accentPrimary};
  --destructive-bg-color: {accentRed};
  --destructive-fg-color: {bgBase};
  --destructive-color: {accentRed};
  --success-bg-color: {accentGreen};
  --success-fg-color: {bgBase};
  --success-color: {accentGreen};
  --warning-bg-color: {accentOrange};
  --warning-fg-color: {bgBase};
  --warning-color: {accentOrange};
  --error-bg-color: {accentRed};
  --error-fg-color: {bgBase};
  --error-color: {accentRed};
  --window-bg-color: {bgBase};
  --window-fg-color: {textPrimary};
  --view-bg-color: {bgBase};
  --view-fg-color: {textPrimary};
  --headerbar-bg-color: {bgSurface};
  --headerbar-fg-color: {textPrimary};
  --headerbar-border-color: {bgBorder};
  --headerbar-backdrop-color: {bgBase};
  --sidebar-bg-color: {bgSurface};
  --sidebar-fg-color: {textPrimary};
  --sidebar-backdrop-color: {bgBase};
  --secondary-sidebar-bg-color: {bgSurface};
  --secondary-sidebar-fg-color: {textPrimary};
  --secondary-sidebar-backdrop-color: {bgBase};
  --card-bg-color: {bgSurface};
  --card-fg-color: {textPrimary};
  --dialog-bg-color: {bgSurface};
  --dialog-fg-color: {textPrimary};
  --popover-bg-color: {bgSurface};
  --popover-fg-color: {textPrimary};
  --thumbnail-bg-color: {bgSurface};
  --thumbnail-fg-color: {textPrimary};
  --scrollbar-outline-color: {bgBorder};
}}

@define-color accent_bg_color {accentPrimary};
@define-color accent_fg_color {bgBase};
@define-color accent_color {accentPrimary};
@define-color destructive_bg_color {accentRed};
@define-color destructive_fg_color {bgBase};
@define-color destructive_color {accentRed};
@define-color success_bg_color {accentGreen};
@define-color success_fg_color {bgBase};
@define-color success_color {accentGreen};
@define-color warning_bg_color {accentOrange};
@define-color warning_fg_color {bgBase};
@define-color warning_color {accentOrange};
@define-color error_bg_color {accentRed};
@define-color error_fg_color {bgBase};
@define-color error_color {accentRed};
@define-color window_bg_color {bgBase};
@define-color window_fg_color {textPrimary};
@define-color view_bg_color {bgBase};
@define-color view_fg_color {textPrimary};
@define-color headerbar_bg_color {bgSurface};
@define-color headerbar_fg_color {textPrimary};
@define-color headerbar_border_color {bgBorder};
@define-color headerbar_backdrop_color {bgBase};
@define-color sidebar_bg_color {bgSurface};
@define-color sidebar_fg_color {textPrimary};
@define-color sidebar_backdrop_color {bgBase};
@define-color secondary_sidebar_bg_color {bgSurface};
@define-color secondary_sidebar_fg_color {textPrimary};
@define-color secondary_sidebar_backdrop_color {bgBase};
@define-color card_bg_color {bgSurface};
@define-color card_fg_color {textPrimary};
@define-color dialog_bg_color {bgSurface};
@define-color dialog_fg_color {textPrimary};
@define-color popover_bg_color {bgSurface};
@define-color popover_fg_color {textPrimary};
@define-color thumbnail_bg_color {bgSurface};
@define-color thumbnail_fg_color {textPrimary};
@define-color scrollbar_outline_color {bgBorder};
@define-color theme_bg_color {bgBase};
@define-color theme_fg_color {textPrimary};
@define-color theme_base_color {bgBase};
@define-color theme_text_color {textPrimary};
@define-color theme_selected_bg_color {accentPrimary};
@define-color theme_selected_fg_color {bgBase};
@define-color theme_unfocused_bg_color {bgBase};
@define-color theme_unfocused_fg_color {textSecondary};
@define-color theme_unfocused_base_color {bgBase};
@define-color theme_unfocused_text_color {textSecondary};
@define-color theme_unfocused_selected_bg_color {accentPrimary};
@define-color theme_unfocused_selected_fg_color {bgBase};
@define-color insensitive_bg_color {bgSurface};
@define-color insensitive_fg_color {textMuted};
@define-color insensitive_base_color {bgBase};
@define-color borders {bgBorder};
@define-color unfocused_borders {bgBorder};
"""
os.makedirs(os.path.join(conf,'gtk-4.0'), exist_ok=True)
open(os.path.join(conf,'gtk-4.0','gtk.css'),'w',encoding='utf-8').write(gtk4)

gtk3 = gtk4.replace(':root {', '/* GTK3 */').split('/* GTK3 */',1)[1] if ':root {' in gtk4 else gtk4
# write a simpler gtk3 file (no :root vars)
gtk3 = f"""@define-color accent_bg_color {accentPrimary};
@define-color accent_fg_color {bgBase};
@define-color accent_color {accentPrimary};
@define-color destructive_bg_color {accentRed};
@define-color destructive_fg_color {bgBase};
@define-color destructive_color {accentRed};
@define-color success_bg_color {accentGreen};
@define-color success_fg_color {bgBase};
@define-color success_color {accentGreen};
@define-color warning_bg_color {accentOrange};
@define-color warning_fg_color {bgBase};
@define-color warning_color {accentOrange};
@define-color error_bg_color {accentRed};
@define-color error_fg_color {bgBase};
@define-color error_color {accentRed};
@define-color window_bg_color {bgBase};
@define-color window_fg_color {textPrimary};
@define-color view_bg_color {bgBase};
@define-color view_fg_color {textPrimary};
@define-color headerbar_bg_color {bgSurface};
@define-color headerbar_fg_color {textPrimary};
@define-color headerbar_border_color {bgBorder};
@define-color headerbar_backdrop_color {bgBase};
@define-color sidebar_bg_color {bgSurface};
@define-color sidebar_fg_color {textPrimary};
@define-color sidebar_backdrop_color {bgBase};
@define-color card_bg_color {bgSurface};
@define-color card_fg_color {textPrimary};
@define-color dialog_bg_color {bgSurface};
@define-color dialog_fg_color {textPrimary};
@define-color popover_bg_color {bgSurface};
@define-color popover_fg_color {textPrimary};
@define-color theme_bg_color {bgBase};
@define-color theme_fg_color {textPrimary};
@define-color theme_base_color {bgBase};
@define-color theme_text_color {textPrimary};
@define-color theme_selected_bg_color {accentPrimary};
@define-color theme_selected_fg_color {bgBase};
@define-color insensitive_bg_color {bgSurface};
@define-color insensitive_fg_color {textMuted};
@define-color borders {bgBorder};
@define-color unfocused_borders {bgBorder};
"""
os.makedirs(os.path.join(conf,'gtk-3.0'), exist_ok=True)
open(os.path.join(conf,'gtk-3.0','gtk.css'),'w',encoding='utf-8').write(gtk3)

# btop: ensure theme selection
btop_conf = os.path.join(conf,'btop','btop.conf')
os.makedirs(os.path.dirname(btop_conf), exist_ok=True)
if os.path.exists(btop_conf):
    try:
        with open(btop_conf,'r',encoding='utf-8',errors='ignore') as f:
            txt = f.read()
        if 'color_theme' in txt:
            lines = []
            for line in txt.splitlines():
                if line.strip().startswith('color_theme'):
                    lines.append('color_theme = "muze"')
                else:
                    lines.append(line)
            txt = '\n'.join(lines).rstrip('\n') + '\n'
        else:
            txt = txt.rstrip('\n') + '\ncolor_theme = "muze"\n'
        with open(btop_conf,'w',encoding='utf-8') as f:
            f.write(txt)
    except Exception:
        pass
else:
    with open(btop_conf,'w',encoding='utf-8') as f:
        f.write('color_theme = "muze"\ntheme_background = False\n')

# Reload hooks (best effort)
for s in glob.glob('/tmp/kitty-*'):
    if os.path.exists(s):
        subprocess.run(['kitty','@','--to',f'unix:{s}','set-colors','--all','--configured', os.path.join(conf,'kitty','muze-colors.conf')], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
subprocess.run(['pkill','-SIGUSR1','foot'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

# Nautilus palette from applied theme/preset palette
try:
    import json as _json
    _pal = _json.dumps(data)
    _cmd = os.path.join(os.path.expanduser('~'), '.local', 'bin', 'muze-nautilus-palette')
    if not os.path.exists(_cmd):
        _cmd = 'muze-nautilus-palette'
    subprocess.run([_cmd, '-'], input=_pal.encode('utf-8'), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
except Exception:
    pass

print('ok')
PY
