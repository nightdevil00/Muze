#!/usr/bin/env bash
# muze-idle -- translate Muze's power settings into a hypridle config.
#
# hypridle has no live-reload, so this regenerates
#   ~/.config/muze/hypridle.conf
# from ~/.config/muze/settings.json and restarts hypridle only when the
# generated file actually changed.
#
# Settings (all optional, defaults match the shipped behaviour):
#   power.lockEnabled       bool   lock the session after lockMinutes
#   power.lockMinutes       int    minutes of idleness before locking
#   power.screenOffEnabled  bool   turn the panel off after screenOffMinutes
#   power.screenOffMinutes  int    minutes of idleness before DPMS off
#   power.suspendEnabled    bool   suspend after suspendMinutes
#   power.suspendMinutes    int    minutes of idleness before suspend
#
# A timeout of 0 disables that action even if its enable toggle is on. When
# lockEnabled is off, suspending no longer locks the session first.
#
# The generated config uses the muze-dpms / muze-repaint helpers because
# `hyprctl dispatch` no longer works under Hyprland 0.57's Lua config, and a
# stale scanout frame (e.g. the lock screen on a secondary monitor) is only
# cleared by forcing a repaint on unlock/wake.
set -u
export PATH="$HOME/.local/bin:$PATH"

DRY=0
case "${1:-}" in
    --dry-run|-n) DRY=1 ;;
    --help|-h)
        awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
        exit 0 ;;
esac

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/muze"
CONF="$CONF_DIR/hypridle.conf"
SETTINGS="$CONF_DIR/settings.json"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/muze"

log() { printf '[muze-idle] %s\n' "$*" >> "$STATE_DIR/session.log" 2>/dev/null || true; }

mkdir -p "$CONF_DIR" "$STATE_DIR" 2>/dev/null || true

# Defaults: lock at 5 min, display off at 6 min, suspend at 15 min.
lock_enabled=true
lock_min=5
screen_enabled=true
screen_min=6
suspend_enabled=true
suspend_min=15

if [[ -f "$SETTINGS" ]] && command -v jq >/dev/null 2>&1; then
    # Note: do NOT use jq's `//` here -- it treats false as "empty" and would
    # turn every disabled toggle back on.
    lock_enabled=$(  jq -r '.power.lockEnabled'      "$SETTINGS" 2>/dev/null)
    lock_min=$(      jq -r '.power.lockMinutes'      "$SETTINGS" 2>/dev/null)
    screen_enabled=$(jq -r '.power.screenOffEnabled' "$SETTINGS" 2>/dev/null)
    screen_min=$(    jq -r '.power.screenOffMinutes' "$SETTINGS" 2>/dev/null)
    suspend_enabled=$(jq -r '.power.suspendEnabled'  "$SETTINGS" 2>/dev/null)
    suspend_min=$(   jq -r '.power.suspendMinutes'   "$SETTINGS" 2>/dev/null)

    case "$lock_enabled"    in true|false) ;; *) lock_enabled=true ;;    esac
    case "$screen_enabled"  in true|false) ;; *) screen_enabled=true ;;  esac
    case "$suspend_enabled" in true|false) ;; *) suspend_enabled=true ;; esac
fi

# Normalize numbers and keep the defaults for missing/invalid values.
[[ "$lock_min"    =~ ^[0-9]+$ ]] || lock_min=5
[[ "$screen_min"  =~ ^[0-9]+$ ]] || screen_min=6
[[ "$suspend_min" =~ ^[0-9]+$ ]] || suspend_min=15

[[ "$lock_enabled"    == "true" ]] || lock_enabled=false
[[ "$screen_enabled"  == "true" ]] || screen_enabled=false
[[ "$suspend_enabled" == "true" ]] || suspend_enabled=false

(( lock_min    > 0 )) || lock_enabled=false
(( screen_min  > 0 )) || screen_enabled=false
(( suspend_min > 0 )) || suspend_enabled=false

tmp=$(mktemp "${TMPDIR:-/tmp}/muze-hypridle.XXXXXX") || exit 1

{
    echo "# Generated by muze-idle from ~/.config/muze/settings.json."
    echo "# Do not edit: change it in Muze Settings -> Power instead."
    echo "general {"
    echo "    lock_cmd = pidof hyprlock || hyprlock"
    echo "    unlock_cmd = killall hyprlock; muze-repaint"
    # Only lock on sleep when the idle lock is actually enabled; otherwise a
    # suspend would still pop the lock screen the user asked to turn off.
    if [[ "$lock_enabled" == "true" ]]; then
        echo "    before_sleep_cmd = loginctl lock-session"
    fi
    echo "    after_sleep_cmd = muze-dpms on; muze-repaint"
    echo "    ignore_dbus_inhibit = false"
    echo "}"
    echo

    if [[ "$lock_enabled" == "true" ]]; then
        echo "listener {"
        echo "    timeout = $((lock_min * 60))"
        echo "    on-timeout = loginctl lock-session"
        echo "}"
        echo
    fi

    if [[ "$screen_enabled" == "true" ]]; then
        echo "listener {"
        echo "    timeout = $((screen_min * 60))"
        echo "    on-timeout = muze-dpms off"
        echo "    on-resume = muze-dpms on"
        echo "}"
        echo
    fi

    if [[ "$suspend_enabled" == "true" ]]; then
        echo "listener {"
        echo "    timeout = $((suspend_min * 60))"
        echo "    on-timeout = systemctl suspend"
        echo "}"
        echo
    fi
} > "$tmp"

if (( DRY )); then
    cat "$tmp"
    rm -f "$tmp"
    exit 0
fi

# Nothing changed and hypridle is already running with this config: done.
if [[ -f "$CONF" ]] && cmp -s "$tmp" "$CONF" && pgrep -x hypridle >/dev/null 2>&1; then
    rm -f "$tmp"
    exit 0
fi

mv -f "$tmp" "$CONF"

# Restart hypridle so the new listeners take effect immediately.
if pgrep -x hypridle >/dev/null 2>&1; then
    pkill -x hypridle 2>/dev/null || true
    for _ in $(seq 1 40); do
        pgrep -x hypridle >/dev/null 2>&1 || break
        sleep 0.05
    done
fi

if command -v hypridle >/dev/null 2>&1; then
    setsid hypridle -c "$CONF" >/dev/null 2>&1 &
    log "hypridle started (lock=$lock_enabled/${lock_min}m screen=$screen_enabled/${screen_min}m suspend=$suspend_enabled/${suspend_min}m)"
else
    log "hypridle is not installed"
fi
