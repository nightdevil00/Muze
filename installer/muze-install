#!/usr/bin/env bash
# muze-install -- Muze hybrid installer (offline + online, dualboot, repair).
#
# Config-first: everything is written to install.toml, shown to the user as a
# list of differences, and only applied after explicit approval. Re-running
# with --config install.toml reproduces the same install deterministically.
#
#   muze-install                     interactive wizard
#   muze-install --config FILE       apply an existing config (still confirms)
#   muze-install --config FILE --yes skip the final confirmation (unattended)
#   muze-install --config FILE --dry-run  show what would happen, write nothing
#   muze-install --repair            mount an existing system for chroot repair
#   muze-install --detect            print the L1 hardware proposal and exit
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MUZE_ROOT="${MUZE_ROOT:-$(cd "$SELF_DIR/.." && pwd)}"
export MUZE_ROOT

CONFIG=""
ASSUME_YES=0
DO_REPAIR=0
DETECT_ONLY=0
DRY_RUN=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --config) CONFIG=$2; shift 2 ;;
        --yes|-y) ASSUME_YES=1; shift ;;
        --repair) DO_REPAIR=1; shift ;;
        --detect) DETECT_ONLY=1; shift ;;
        --dry-run) DRY_RUN=1; shift ;;
        -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
        *) printf 'unknown option: %s\n' "$1" >&2; exit 2 ;;
    esac
done

LOGFILE="/root/muze-install_$(date +%Y%m%d_%H%M%S).log"
mkdir -p "$(dirname "$LOGFILE")"
exec > >(tee -a "$LOGFILE") 2>&1

# --------------------------------------------------------------------- UI ----
# gum (modern) -> dialog -> plain read. Everything works without any of them.
if command -v gum >/dev/null 2>&1; then UI=gum
elif command -v dialog >/dev/null 2>&1; then UI=dialog
else UI=plain
fi

ui_style() { # ui_style <text>
    if [[ $UI == gum ]]; then gum style --border rounded --padding "1 2" --foreground 212 "$1"
    else printf '\n== %s ==\n\n' "$1"; fi
}
ui_header() {
    if [[ $UI == gum ]]; then
        gum style --foreground 212 --bold "MUZE" | gum style --padding "1 2"
        printf '\n'
    else
        printf '\n=========================\n  M U Z E   installer\n=========================\n\n'
    fi
}
ui_info()  { printf '\033[0;34m  INFO\033[0m    %s\n' "$*"; }
ui_ok()    { printf '\033[0;32m  OK\033[0m      %s\n' "$*"; }
ui_warn()  { printf '\033[1;33m  WARN\033[0m    %s\n' "$*"; }
ui_abort() { printf '\033[0;31m  ABORT\033[0m   %s\n' "$*"; exit 1; }

ui_choose() { # ui_choose <prompt> <option...> -> echoes chosen
    local prompt=$1; shift
    [[ $# -gt 0 ]] || return 1
    while :; do
        if [[ $UI == gum ]]; then
            local sel
            sel=$(printf '%s\n' "$@" | gum choose --header "$prompt" --height 15) || true
            [[ -n "$sel" ]] && { printf '%s' "$sel"; return 0; }
        elif [[ $UI == dialog ]]; then
            local args=() i=0
            for o in "$@"; do args+=("$((++i))" "$o"); done
            local n
            n=$(dialog --clear --stdout --menu "$prompt" 20 70 12 "${args[@]}") || n=""
            if [[ -n "$n" ]]; then
                local j=0
                for o in "$@"; do ((++j)); [[ $j -eq $n ]] && { printf '%s' "$o"; return 0; }; done
            fi
        else
            local i=0 o
            for o in "$@"; do printf '  %2d) %s\n' "$((++i))" "$o" >&2; done
            local n j choice=""
            IFS= read -r -p "  $prompt [1-$#]: " n || n=""
            j=0
            for o in "$@"; do
                ((++j))
                if [[ "$n" == "$j" ]]; then choice=$o; break; fi
            done
            if [[ -n "$choice" ]]; then
                printf '%s' "$choice"
                return 0
            fi
            printf '  Invalid selection, try again.\n' >&2
            continue
        fi
        # gum/dialog cancelled or returned empty: re-prompt (or fail on EOF in non-interactive)
        if [[ ! -t 0 ]]; then
            printf '%s' "$1"
            return 0
        fi
        printf '  Selection required, try again.\n' >&2
    done
}

ui_multi() { # ui_multi <prompt> <option...> -> echoes chosen lines
    local prompt=$1; shift
    [[ $# -gt 0 ]] || return 0
    if [[ $UI == gum ]]; then
        printf '%s\n' "$@" | gum choose --no-limit --header "$prompt" --height 15
    elif [[ $UI == dialog ]]; then
        local args=() i=0
        for o in "$@"; do args+=("$((++i))" "$o" off); done
        local sel
        sel=$(dialog --clear --stdout --separate-output --checklist "$prompt" 20 70 12 "${args[@]}") || true
        local j=0
        for o in "$@"; do ((++j)); grep -qx "$j" <<<"$sel" && printf '%s\n' "$o"; done
    else
        local i=0 o
        for o in "$@"; do printf '  %2d) %s\n' "$((++i))" "$o" >&2; done
        local sel j
        IFS= read -r -p "  $prompt (space separated numbers, Enter for none): " sel || sel=""
        j=0
        for o in "$@"; do ((++j)); [[ " $sel " == *" $j "* ]] && printf '%s\n' "$o"; done
    fi
}

ui_input() { # ui_input <prompt> <default>
    local prompt=$1 def=${2:-}
    if [[ $UI == gum ]]; then gum input --header "$prompt" --value "$def"
    elif [[ $UI == dialog ]]; then dialog --clear --stdout --inputbox "$prompt" 8 70 "$def"
    else read -r -p "  $prompt [$def]: " ans; printf '%s' "${ans:-$def}"; fi
}

ui_password() { # ui_password <prompt>
    local prompt=$1 a b
    if [[ $UI == gum ]]; then
        a=$(gum input --password --header "$prompt")
        b=$(gum input --password --header "Confirm password")
    elif [[ $UI == dialog ]]; then
        a=$(dialog --clear --stdout --passwordbox "$prompt" 8 70)
        b=$(dialog --clear --stdout --passwordbox "Confirm password" 8 70)
    else
        read -r -s -p "  $prompt: " a; echo
        read -r -s -p "  Confirm password: " b; echo
    fi
    [[ -n "$a" && "$a" == "$b" ]] || ui_abort "passwords empty or do not match"
    printf '%s' "$a"
}

ui_confirm() { # ui_confirm <prompt> -> return 0/1
    local prompt=$1 a
    if [[ $ASSUME_YES -eq 1 ]]; then return 0; fi
    if [[ $UI == gum ]]; then gum confirm "$prompt" --affirmative "Yes" --negative "No"
    elif [[ $UI == dialog ]]; then dialog --clear --stdout --yesno "$prompt" 8 70
    else
        while :; do
            IFS= read -r -p "  $prompt [Y/n]: " a || { printf '\n'; return 0; }
            case "${a:-y}" in
                [Yy]|[Yy][Ee][Ss]|"") return 0 ;;
                [Nn]|[Nn][Oo]) return 1 ;;
                *) printf '  Please answer y or n.\n' >&2 ;;
            esac
        done
    fi
}

ui_pager() { # ui_pager <file>
    if [[ $UI == gum ]] && [[ -t 1 ]]; then gum pager < "$1"
    else cat "$1"; fi
}

# --------------------------------------------------------------- TOML <-> env -
# install.toml is the contract; python3's tomllib turns it into shell-safe
# KEY=value lines. python3 is in the Muze ISO package set.
toml_to_env() { # toml_to_env <file>
    python3 - "$1" <<'PY'
import sys, tomllib, shlex
with open(sys.argv[1], "rb") as f: d = tomllib.load(f)
def emit(prefix, obj):
    for k, v in obj.items():
        key = prefix + k.upper()
        if isinstance(v, dict): emit(prefix + k.upper() + "_", v)
        elif isinstance(v, bool): print(f"{key}={'true' if v else 'false'}")
        elif isinstance(v, list): print(f"{key}={shlex.quote(' '.join(map(str,v)))}")
        else: print(f"{key}={shlex.quote(str(v))}")
emit("", d)
PY
}

load_config() { # load_config <file> -> exports CFG_* variables
    local f=$1
    [[ -f "$f" ]] || ui_abort "config not found: $f"
    local env_file; env_file=$(mktemp)
    toml_to_env "$f" | sed 's/^/CFG_/' > "$env_file"
    # shellcheck disable=SC1090
    set -a; . "$env_file"; set +a
    rm -f "$env_file"
}

# ------------------------------------------------------------------ detection -
if [[ $DETECT_ONLY -eq 1 ]]; then
    bash "$SELF_DIR/muze-detect" pretty
    exit 0
fi

if [[ $DO_REPAIR -eq 1 ]]; then
    exec bash "$SELF_DIR/muze-repair"
fi

# ------------------------------------------------------------------ wizard ----
ui_header
ui_info "UI backend: $UI   log: $LOGFILE"

DETECT_ENV=$(mktemp)
bash "$SELF_DIR/muze-detect" --shell > "$DETECT_ENV"
# shellcheck disable=SC1090
. "$DETECT_ENV"
rm -f "$DETECT_ENV"

if [[ -z "$CONFIG" ]]; then
    ui_style "Step 1/6 · Hardware (L1)"
    bash "$SELF_DIR/muze-detect" pretty

    CONFIG=${MUZE_CONFIG:-/root/install.toml}
    if ui_confirm "Use the detected proposal as a starting point?"; then
        bash "$SELF_DIR/muze-detect" --toml > "$CONFIG"
    else
        cp "$SELF_DIR/install.toml.example" "$CONFIG"
    fi

    ui_style "Step 2/6 · Identity"
    hostname_v=$(ui_input "Hostname" "muze")
    username_v=$(ui_input "Username" "user")
    timezone_v=$(ui_input "Timezone" "$(timedatectl show -p Timezone --value 2>/dev/null || echo UTC)")
    keymap_v=$(ui_input "Console keymap" "us")
    PASSWORD=$(ui_password "Password for $username_v (also root)")

    ui_style "Step 3/6 · Disk"
    local_disks=()
    while IFS='|' read -r name size model; do
        [[ -z "$name" || "$name" == "$BOOT_DISK" ]] && continue
        local_disks+=("$name ($size) $model")
    done < <(lsblk -dpno NAME,SIZE,MODEL 2>/dev/null | tr -s ' ' '|' \
                | grep -E '^/dev/(sd|hd|vd|nvme|mmcblk|xv)' || true)
    [[ ${#local_disks[@]} -gt 0 ]] || ui_abort "no installable disk found"
    chosen=$(ui_choose "Select the target disk" "${local_disks[@]}")
    disk_v=${chosen%% *}

    if [[ -n "${WIN_EFI:-}" ]]; then
        mode_v=$(ui_choose "Windows EFI found on $WIN_EFI. Install mode?" \
            "dualboot" "fullwipe" "manual")
    else
        mode_v=$(ui_choose "Install mode" "fullwipe" "dualboot" "manual")
    fi
    encrypt_v=$(ui_choose "Encrypt root with LUKS2?" "yes" "no")
    [[ "$encrypt_v" == "yes" ]] && encrypt_v=true || encrypt_v=false

    ui_style "Step 4/6 · Packages"
    profiles_v=$(ui_multi "Select package profiles (space/enter to choose)" \
        "minimal" "student" "dev" "gaming" "creative")
    [[ -z "$profiles_v" ]] && profiles_v="minimal"
    browser_v=$(ui_choose "Browser" "chromium" "firefox" "zen")
    flatpak_v=$(ui_choose "Enable Flatpak?" "no" "yes")
    [[ "$flatpak_v" == "yes" ]] && flatpak_v=true || flatpak_v=false
    source_v=$(ui_choose "Package source" "auto" "offline" "online")

    ui_style "Step 5/6 · Muze defaults"
    theme_v=$(ui_choose "Colour mode" "wallpaper" "theme" "light")
    apps_v=$(ui_choose "Theme third-party GTK apps?" "yes" "no")
    [[ "$apps_v" == "yes" ]] && apps_v=true || apps_v=false

    # Rewrite the config with the answers (keeping the documented schema).
    python3 - "$CONFIG" "$hostname_v" "$username_v" "$timezone_v" "$keymap_v" \
                  "$disk_v" "$mode_v" "$encrypt_v" "$profiles_v" "$browser_v" \
                  "$flatpak_v" "$source_v" "$theme_v" "$apps_v" <<'PY'
import sys, tomllib, pathlib
f = pathlib.Path(sys.argv[1])
d = tomllib.loads(f.read_text())
(h, u, tz, km, disk, mode, enc, profiles, browser, flatpak, src, theme, apps) = sys.argv[2:]
d.setdefault("system", {}).update(hostname=h, username=u, timezone=tz, keymap=km, password_set=True)
d.setdefault("disk", {}).update(device=disk, mode=mode, encrypt=(enc=="true"))
d.setdefault("packages", {}).update(profiles=profiles.split(), browser=browser,
                                    flatpak=(flatpak=="true"), source=src)
d.setdefault("muze", {}).update(theme_mode=theme, theme_apps=(apps=="true"))
def dump(o, indent=""):
    lines=[]
    for k,v in o.items():
        if isinstance(v,dict):
            lines.append(f"\n[{k}]" if not indent else f"\n[{k}]")
            lines.extend(dump(v, indent+"  "))
        elif isinstance(v,bool): lines.append(f"{k} = {'true' if v else 'false'}")
        elif isinstance(v,list): lines.append(f"{k} = [" + ", ".join(f'\"{x}\"' for x in v) + "]")
        elif isinstance(v,(int,float)): lines.append(f"{k} = {v}")
        else: lines.append(f"{k} = \"{v}\"")
    return lines
out = "# Muze install.toml -- reviewed by the user, applied by muze-install\n"
out += "version = 1\n"
out += "\n".join(dump({k:v for k,v in d.items() if k!="version"})) + "\n"
f.write_text(out)
PY
    ui_ok "wrote $CONFIG"
else
    ui_info "using config: $CONFIG"
    PASSWORD=""
fi

# --------------------------------------------------------------- diff / approve -
load_config "$CONFIG"
: "${CFG_VERSION:=1}" "${CFG_SYSTEM_HOSTNAME:=muze}" "${CFG_SYSTEM_USERNAME:=user}"
: "${CFG_SYSTEM_LOCALE:=en_US.UTF-8}" "${CFG_SYSTEM_KEYMAP:=us}" "${CFG_SYSTEM_TIMEZONE:=UTC}"
: "${CFG_DISK_DEVICE:=}" "${CFG_DISK_MODE:=fullwipe}" "${CFG_DISK_FILESYSTEM:=btrfs}"
: "${CFG_DISK_ENCRYPT:=false}" "${CFG_DISK_EFI_SIZE_MB:=512}"
: "${CFG_BOOT_BOOTLOADER:=limine}" "${CFG_BOOT_CHAINLOAD_WINDOWS:=true}"
: "${CFG_PACKAGES_SOURCE:=auto}" "${CFG_PACKAGES_PROFILES:=minimal}"
: "${CFG_PACKAGES_BROWSER:=chromium}" "${CFG_PACKAGES_FLATPAK:=false}"
: "${CFG_PACKAGES_AUR:=false}" "${CFG_PACKAGES_EXTRA:=}"
: "${CFG_AGENT_LEVEL:=1}" "${CFG_AGENT_SNAPSHOT_BEFORE:=true}"
: "${CFG_MUZE_THEME_MODE:=wallpaper}" "${CFG_MUZE_THEME_APPS:=true}"
: "${CFG_MUZE_BAR_HEIGHT:=32}" "${CFG_MUZE_BAR_OPACITY:=100}"

ui_style "Step 6/6 · Review install.toml"
ui_info "This is the complete diff from a bare Arch system. Nothing has been written to disk yet."
ui_pager "$CONFIG"
printf '\n'
if ! ui_confirm "Apply this configuration?"; then
    ui_info "Cancelled. Edit $CONFIG and re-run: muze-install --config $CONFIG"
    exit 0
fi
if [[ $ASSUME_YES -eq 0 ]] && ui_confirm "Open install.toml in an editor first?"; then
    "${EDITOR:-nano}" "$CONFIG"
    load_config "$CONFIG"
fi

if [[ $DRY_RUN -eq 1 ]]; then
    ui_style "Dry run -- nothing will be written to disk"
    printf '  disk      : %s (mode %s, encrypt %s)\n' "$CFG_DISK_DEVICE" "$CFG_DISK_MODE" "$CFG_DISK_ENCRYPT"
    printf '  packages  : source %s, profiles %s, browser %s\n' \
        "$CFG_PACKAGES_SOURCE" "$CFG_PACKAGES_PROFILES" "$CFG_PACKAGES_BROWSER"
    printf '  system    : %s@%s, %s, %s\n' \
        "$CFG_SYSTEM_USERNAME" "$CFG_SYSTEM_HOSTNAME" "$CFG_SYSTEM_LOCALE" "$CFG_SYSTEM_TIMEZONE"
    printf '  muze      : %s theme, bar %spx @ %s%%\n' \
        "$CFG_MUZE_THEME_MODE" "$CFG_MUZE_BAR_HEIGHT" "$CFG_MUZE_BAR_OPACITY"
    printf '\n  Re-run without --dry-run to install.\n'
    exit 0
fi

if [[ -z "$PASSWORD" ]]; then
    PASSWORD=$(ui_password "Password for $CFG_SYSTEM_USERNAME (also root)")
fi

# ------------------------------------------------------------------ apply -----
[[ $EUID -eq 0 ]] || ui_abort "the installer must run as root"
bash "$SELF_DIR/lib/apply.sh" "$CONFIG" "$PASSWORD" "$LOGFILE"
ui_ok "installation complete. Log: $LOGFILE"
if ui_confirm "Reboot now?"; then reboot; fi
