# Muze install.toml - configuration contract for muze-install.
# Edit and run: sudo muze-install --config install.toml
#
# The installer wizard can generate this file. Applying the same config
# should reproduce the same install choices.

version = 1

[system]
hostname     = "muze"
username     = "user"
locale       = "en_US.UTF-8"
keymap       = "us"
timezone     = "Europe/Bucharest"
password_set = false

[disk]
# Target disk for fullwipe/dualboot modes (installer refuses the live USB).
device       = "/dev/nvme0n1"
# fullwipe | dualboot | manual
mode         = "fullwipe"
filesystem   = "btrfs"
encrypt      = true
efi_size_mb  = 512
# Used only when mode = "manual"
efi_device   = ""
root_device  = ""

[boot]
# limine | systemd-boot
bootloader        = "limine"
# Add Windows chainload entry when a Windows EFI is present.
chainload_windows = true
kernels           = ["linux"]
# Enable Btrfs snapshot integration (snapper + boot menu support where available).
snapshots         = true

[packages]
# auto | online | offline
source   = "auto"
# Profile names map to packages/profiles/<name>.packages (cumulative).
profiles = ["minimal", "dev"]
# chromium | firefox | zen
browser  = "chromium"
flatpak  = false
aur      = false
# Extra packages added on top of profiles (space significance irrelevant in array).
extra    = []

[agent]
level           = 1
snapshot_before = true

[muze]
theme_mode  = "wallpaper"
theme_apps  = true
bar_height  = 32
bar_opacity = 100
profile     = "default"
